{
  "name": "aegis",
  "displayName": "AEGIS",
  "description": "Developer intelligence for predicting Java and Spring Boot code change impact before refactoring.",
  "version": "0.1.0",
  "publisher": "aegis-devtools",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/sumitsdeore/AEGIS.git"
  },
  "bugs": {
    "url": "https://github.com/sumitsdeore/AEGIS/issues"
  },
  "homepage": "https://github.com/sumitsdeore/AEGIS#readme",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "java",
    "spring",
    "spring-boot",
    "static-analysis",
    "refactoring",
    "dependency-graph"
  ],
  "activationEvents": [
    "onCommand:aegis.analyzeProject",
    "onCommand:aegis.showImpactGraph"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aegis.analyzeProject",
        "title": "AEGIS: Analyze Project",
        "category": "AEGIS"
      },
      {
        "command": "aegis.showImpactGraph",
        "title": "AEGIS: Show Impact Graph",
        "category": "AEGIS"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "aegis.analyzeProject"
        },
        {
          "command": "aegis.showImpactGraph"
        }
      ]
    },
    "configuration": {
      "title": "AEGIS",
      "properties": {
        "aegis.analyzer.jarPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional path to the AEGIS analyzer JAR. Relative paths are resolved from the workspace folder."
        }
      }
    }
  },
  "scripts": {
    "build-webview": "node ./scripts/build-webview.mjs",
    "compile": "tsc -p ./ && npm run build-webview",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "node ./dist/test/smoke.test.js",
    "stage-analyzer": "node ./scripts/stage-analyzer.mjs",
    "package": "npm run compile && npm run stage-analyzer && vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.92.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.8.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.0",
    "@xyflow/react": "^12.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
